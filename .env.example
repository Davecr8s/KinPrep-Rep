# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are sent to the browser and must not be secrets.
# Every other value is server-only and is validated in src/lib/env.ts.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>". At least 32 characters.
CRON_SECRET=

# Supabase (Phase 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe: GBP, USD, CAD (Phase 4)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack: NGN (Phase 4). The secret key also verifies webhook signatures.
PAYSTACK_SECRET_KEY=

# WhatsApp Cloud API (Phase 8)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# LLM for scoped explanations (Phase 7)
LLM_API_KEY=
LLM_MODEL=
