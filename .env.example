# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are sent to the browser and must not be secrets.
# Every other value is server-only and is validated in src/lib/env.ts.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cron jobs. Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>". At least 32 characters.
CRON_SECRET=

# Supabase (Phase 1). Dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Direct Postgres, used by the WhatsApp bot, the web practice page and npm run db:push.
# Dashboard > Connect > Transaction pooler (port 6543) connection string, with your database password.
SUPABASE_DB_URL=
# Optional: connections per server instance (default 3).
SUPABASE_DB_POOL_MAX=

# Web practice links (/p/<token>). Any random string of 32+ characters, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every practice link already sent.
PRACTICE_LINK_SECRET=

# Stripe: GBP, USD, CAD. Use test keys (sk_test_...) until launch.
STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint, or printed by `stripe listen` when testing locally.
STRIPE_WEBHOOK_SECRET=

# Paystack: NGN. The secret key also verifies webhook signatures.
PAYSTACK_SECRET_KEY=
# Recurring card plans, printed by: node scripts/paystack-plans.ts
PAYSTACK_PLAN_NIGERIA_WEEKLY=
PAYSTACK_PLAN_NIGERIA_MONTHLY=

# WhatsApp Cloud API, direct from Meta (Phase 8). Not needed for the simulator.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app > App settings > Basic > App secret (verifies X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Any random string of 16+ characters; enter the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# WhatsApp Manager > Account tools > WhatsApp account id. Only for: node scripts/meta-templates.ts
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Email for payers who haven't opted in to WhatsApp (resend.com). Until set, emails wait in the queue.
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g.: KinPrep <reports@kinprep.ng>
EMAIL_FROM=

# LLM (Anthropic API, console.anthropic.com): drafts questions for review (/admin/questions) and,
# in Phase 7, scoped explanations. Until set, "Draft 10 questions" is switched off.
LLM_API_KEY=
# e.g. claude-sonnet-5-5
LLM_MODEL=

# Error monitoring (sentry.io, free plan is enough): Project settings > Client keys > DSN.
# Until set, errors go to the Vercel logs only.
SENTRY_DSN=
# Optional: the environment name in Sentry (default: Vercel's production / preview / development).
SENTRY_ENVIRONMENT=

# Rate limits on public routes. Any random string of 32+ characters (falls back to CRON_SECRET).
RATE_LIMIT_SECRET=
